    "Apple Watch users get the most accurate signals. iPhone-only users can still see sleep data from manually logged entries or connected third-party apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch users get the most accurate signals. iPhone-only users can still see sleep data from manually logged entries or connected third-party apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch 使用者は最も正確なシグナルを取得できます。iPhone のみの場合でも、手動入力や連携済みサードパーティ App から睡眠データを確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch 사용자는 가장 정확한 신호를 얻을 수 있습니다. iPhone만 사용해도 수동 기록 또는 연동된 서드파티 앱에서 수면 데이터를 볼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch 用户可获得最准确的信号。仅使用 iPhone 的用户也能看到睡眠数据，前提是手动记录或连接了第三方 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch 使用者可獲得最準確的訊號。僅使用 iPhone 的使用者也能看到睡眠資料，前提是手動記錄或連接了第三方 App。"
          }
        }
      }
    },
