      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulated values feed PlantStage.derive as if they were the real AchievementManager snapshot. Cleared via the “Clear All Simulations” button."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シミュレーション値は PlantStage.derive への入力として実 AchievementManager スナップショットの代わりに使用されます。「すべてのシミュレーションをクリア」で解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시뮬레이션 값은 실제 AchievementManager 스냅샷인 것처럼 PlantStage.derive 에 전달됩니다. 「모든 시뮬레이션 지우기」 로 해제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模拟值会当作真实的 AchievementManager 快照喂给 PlantStage.derive。可通过「清除全部模拟」解除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模擬值會當作真實的 AchievementManager 快照餵給 PlantStage.derive。可透過「清除全部模擬」解除。"
          }
        }
      }
    },
