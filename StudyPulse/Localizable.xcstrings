    "Around 6-7 hours of sleep. Stick to revision and easy problems today; save deep focus for after a good night's rest." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Around 6-7 hours of sleep. Stick to revision and easy problems today; save deep focus for after a good night's rest."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠時間は約 6〜7 時間。今日復習中心・易しい問題にし、深い集中はよく眠った後にとっておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6~7시간 정도 잠을 잤습니다. 오늘은 복습과 쉬운 문제 위주로, 깊은 집중은 충분히 주무신 다음으로 미루세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠约 6-7 小时。今天以复习和简单题为主；充分休息后再进行深度学习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠約 6-7 小時。今天以複習和簡單題為主；充分休息後再進行深度學習。"
          }
        }
      }
    },
