    "Quote 1" : {
      "comment" : "Daily motivational quotes (HomeView)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learning is not a race, it's a marathon — the one who persists to the end is the winner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勉強はレースではなくマラソンです。最後まで続ける者が勝者です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학습은 경주가 아니라 마라톤입니다. 끝까지坚持하는 사람이 승자입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学习不是一场比赛，而是一场马拉松，坚持到最后的人才是赢家。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "學習不是一場比賽，而是一場馬拉松，堅持到最後的人才是贏家。"
          }
        }
      }
    },
    "Quote 2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every effort you make is your future self waving to you right now."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今のあなたの努力は、未来のあなたが今のあなたに手を振っているのです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 모든 노력은 미래의 당신이 지금의 당신에게 손을 흔드는 것입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次的努力，都是未来的你在向现在的你招手。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次的努力，都是未來你在向現在的你招手。"
          }
        }
      }
    },
    "Quote 3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knowledge is like the ocean — the deeper you go, the smaller you feel, but the closer you get to truth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知識は海のようです。深く入るほど自分の小ささに気づきますが、同時に真理に近づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지식은 바다와 같습니다. 깊이 들어갈수록 자신의 작음을 깨닫지만, 동시에 진리에 가까워집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知识就像海洋，越深入越发现自己的渺小，但也越接近真理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知識就像海洋，越深入越發現自己的渺小，但也越接近真理。"
          }
        }
      }
    },
    "Quote 4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's sweat is tomorrow's harvest; today's persistence is tomorrow's success."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の汗は明日の収穫、今日の努力は未来への成功。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 땀은 내일의 수확, 오늘의 인고는 미래의 성공입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的汗水，是明天的收获；今天的坚持，是未来的成功。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的汗水，是明天的收穫；今天的堅持，是未來的成功。"
          }
        }
      }
    },
    "Quote 5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learning is like climbing a mountain — the journey is tough, but the view at the top is worth every effort."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勉強は山登りのようなもの。過程は大変ですが、頂上からの景色は努力の甲斐があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학습은 등산과 같습니다. 과정은 힘들지만 정상에서의 풍경은 모든 노력의 가치가 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学习就像爬山，虽然过程艰辛，但登顶后的风景值得一切努力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "學習就像爬山，雖然過程艱辛，但登頂後的風景值得一切努力。"
          }
        }
      }
    },
    "Quote 6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't give up after one failure; every setback is a chance to grow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度の失敗で諦めないでください。すべての挫折は成長のチャンスです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번의 실패로 포기하지 마세요. 모든 좌절은 성장의 기회입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要因为一次失败就放弃，每一次挫折都是成长的机会。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要因為一次失敗就放棄，每一次挫折都是成長的機會。"
          }
        }
      }
    },
    "Quote 7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knowledge is the best investment; time is the most precious resource."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知識は最良の投資、時間は最も貴重な資源です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지식은 최선의 투자이며 시간은 가장 귀중한 자원입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知识是最好的投资，时间是最宝贵的资源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知識是最好的投資，時間是最寶貴的資源。"
          }
        }
      }
    },
    "Quote 8" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no shortcut in learning — only steady, persistent steps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勉強に近道はありません。一歩ずつ着実に続けるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학습에 지름길은 없습니다. 한 걸음 한 걸음 꾸준히 나아갈 뿐입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学习的路上没有捷径，只有一步一个脚印的坚持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "學習的路上沒有捷徑，只有一步一個腳印的堅持。"
          }
        }
      }
    },
    "Quote 9" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your potential exceeds your imagination. As long as you don't give up, anything is possible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの可能性は無限大です。諦めなければ何でも実現できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 잠재력은 상상을 초월합니다. 포기하지 않는다면 모든 것이 가능합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的潜力超乎你的想象，只要不放弃，一切皆有可能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的潛力超乎你的想像，只要不放棄，一切皆有可能。"
          }
        }
      }
    },
    "Quote 10" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Success is not an endpoint, but a continuous process of learning and growth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功はゴールではなく、継続的な学習と成長の過程です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성공은 종착점이 아니라 끊임없는 학습과 성장의 과정입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功不是终点，而是不断学习和成长的过程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功不是終點，而是不斷學習和成長的過程。"
          }
        }
      }
    },
    "Quote 11" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A little progress every day — a year from now, you'll thank yourself."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日少しずつ進歩すれば、1年後の自分が今のあなたに感謝します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 조금씩进步하면 1년 후의 당신이 지금의 자신에게 감사할 것입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天进步一点点，一年后你会感谢今天的自己。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天進步一點點，一年後你會感謝今天的自己。"
          }
        }
      }
    },
    "Quote 12" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learning is the lighthouse that lights the future; persistence is the oar that gets you there."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勉強は未来を照らす灯台、続けることは彼岸に渡る櫂。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학습은 미래를 비추는 등대이고, 坚持는 그 곳에 닿는 노입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学习是照亮未来的灯塔，坚持是到达彼岸的船桨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "學習是照亮未來的燈塔，堅持是到達彼岸的船槳。"
          }
        }
      }
    },
    "Quote 13" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wrong path can have captivating scenery — you look, you step in, you walk, and you can never find your way out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間違った道には魅惑的な風景が広がっています。見ているうちに足を踏み入れ、歩くうちに抜けられなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘못된 길에는 매혹적인 풍경이 있습니다. 보다가, 보다가, 참지 못하고 들어서면, 걷다가, 걷다가, 다시는 빠져나올 수 없게 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因为歧路上有迷人的风景，看着、看着，就忍不住走进去了，走着、走着，就再也走不出来了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因為歧路上有迷人的風景，看著、看著，就忍不住走進去了，走著、走著，就再也走不出來了。"
          }
        }
      }
    },
    "Quote 14" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To succeed, go all in — set your mind and charge forward!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功したければ、覚悟を決めて突っ走れ！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성공하려면 먼저 미쳐라, 결심을 굳히고 앞으로 돌진하라!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要成功，先发疯，下定决心往前冲！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要成功，先發瘋，下定決心往前衝！"
          }
        }
      }
    },
