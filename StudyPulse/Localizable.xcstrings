    "This will reset subject list and auto-check required subjects for %@ - %@. Existing enabled preferences will be kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will reset subject list and auto-check required subjects for %@ - %@. Existing enabled preferences will be kept."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "科目リストをリセットし、%@ - %@ の必修科目を自動的にチェックします。既存の有効な設定は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "과목 목록을 재설정하고 %@ - %@의 필수 과목을 자동으로 체크합니다. 기존에 활성화한 설정은 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将重置科目列表，并自动勾选 %@ - %@ 的必修科目。已启用的偏好设置将保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
