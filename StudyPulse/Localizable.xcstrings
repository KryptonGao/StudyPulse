    "Low = well-recovered, primed for deep work. High = tired or stressed, ease into the day." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low = well-recovered, primed for deep work. High = tired or stressed, ease into the day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低め = 回復良好、深い学習向き。高め = 疲労・ストレスあり、ゆっくり始めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮음 = 회복良好, 딥 워크 적합. 높음 = 피곤·스트레스, 오늘은 천천히."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏低 = 恢复良好，适合深度学习；偏高 = 疲劳或压力大，今天悠着来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏低 = 恢復良好，適合深度學習；偏高 = 疲勞或壓力大，今天悠著來。"
          }
        }
      }
    },
