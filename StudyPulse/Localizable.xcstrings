    "Excellent sleep and a low resting heart rate — tackle your hardest subject first while energy is highest." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excellent sleep and a low resting heart rate — tackle your hardest subject first while energy is highest."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十分な睡眠と低い安静時心率——エネルギーが最も高いうちに一番難しい科目から取り組みましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "충분한 수면과 낮은 안정 심박수——에너지가 가장 높은 지금 가장 어려운 과목부터 도전하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠充足且静息心率低——趁着精力最旺盛，先攻克最难的科目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠充足且靜息心率低——趁著精力最旺盛，先攻克最難的科目。"
          }
        }
      }
    },
