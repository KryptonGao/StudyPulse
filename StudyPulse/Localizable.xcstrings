    "Your heart rate is well above resting — recently active. Give yourself 10-15 minutes before tackling demanding material." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your heart rate is well above resting — recently active. Give yourself 10-15 minutes before tackling demanding material."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率が安静時よりずっと高い——活動直後です。ハードな学習を始める前に 10〜15 分休みましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박수가 안정 시보다 훨씬 높습니다 — 방금 활동했습니다. 강도 높은 학습을 시작하기 전에 10~15분 휴식을 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的心率仍远高于静息水平——刚结束活动。给自己 10-15 分钟再开始高强度学习。"
          }
        },
        "zh-Hant" : {
