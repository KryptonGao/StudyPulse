    "knowledge.fault.overview.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repeated errors can point to a missing prerequisite, not just a single wrong answer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繰り返す間違いは、一問の問題ではなく前提概念の不足を示すことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "반복되는 오답은 한 문제의 실수보다 선행 개념의 부족을 나타낼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反复出错可能不是一道题的问题，而是某个前置概念还没有稳固。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反覆出錯可能不是一道題的問題，而是某個前置概念還不穩固。"
          }
        }
      }
