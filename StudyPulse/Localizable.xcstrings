    "homeLayout.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to reorder. Toggle off to hide. Full-width cards like the Learning Heatmap always span the entire row on iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで並べ替え。スイッチで非表示にできます。学習ヒートマップなどのフル幅カードは iPad で常に 1 行を占めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 순서 변경, 스위치로 숨기기 가능. 학습 히트맵 같은 전체 너비 카드는 iPad에서 항상 한 줄을 차지합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动可重新排序，关闭开关即可隐藏。宽幅卡片（如学习热力图）在 iPad 上始终独占整行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖動可重新排序，關閉開關即可隱藏。寬幅卡片（如學習熱力圖）在 iPad 上始終獨佔整行。"
          }
        }
      }
