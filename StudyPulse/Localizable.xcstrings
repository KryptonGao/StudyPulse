    "Permanently delete grades, mistakes and todos. This action cannot be undone. Please export your data first if you may need it later." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently delete grades, mistakes and todos. This action cannot be undone. Please export your data first if you may need it later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成績、間違い、およびToDoを完全に削除します。この操作は取り消せません。後で必要になる可能性がある場合は、先にデータをエクスポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성적, 오답 및 할 일을 완전히 삭제합니다. 이 작업은 취소할 수 없습니다. 나중에 필요할 수 있는 경우 먼저 데이터를 내보내십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除成绩、错题和待办事项。此操作无法撤销。如需保留数据，请先导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久刪除成績、錯題和待辦事項。此操作無法復原。如需保留資料，請先匯出。"
          }
        }
      }
    },
