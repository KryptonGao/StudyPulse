    "debug.sectionFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toggles below require the master switch above. Changes are saved instantly and take effect on every page. Available in all builds, including App Store release."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下のサブトグルはマスター开关がオンの時のみ動作します。設定は即時保存され、すべてのページに反映されます。リリースビルドでも利用可能。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 하위 토글은 마스터 스위치가 켜져 있을 때만 작동합니다. 설정은 즉시 저장되며 모든 페이지에 적용됩니다. 릴리스 빌드에서도 사용 가능."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下方子开关需先开启总开关。设置即时保存,对所有页面生效。Release 构建同样可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下方子開關需先開啟總開關。設定即時儲存,對所有頁面生效。Release 建置同樣可用。"
          }
        }
      }
    },
