    "Controls how often the Recovery Radar automatically asks the LLM. Analyze now can bypass this cooldown." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controls how often the Recovery Radar automatically asks the LLM. Analyze now can bypass this cooldown."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リカバリーレーダーが LLM に自動分析を依頼する頻度を設定します。「今すぐ分析」はこのクールダウンを無視できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복 레이더가 LLM에 자동 분석을 요청하는 주기를 설정합니다. ‘지금 분석’은 이 대기 시간을 건너뛸 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制恢复雷达自动请求大模型的频率。“立刻分析”可以绕过此冷却时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制恢復雷達自動請求大型語言模型的頻率。「立即分析」可以繞過此冷卻時間。"
          }
        }
      }
    },
