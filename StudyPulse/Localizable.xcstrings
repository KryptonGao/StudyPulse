          }
        }
      }
    },
    "Your HRV is personal — StudyPulse builds your own baseline over 7-14 days, so recommendations are tailored to you, not a population average." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your HRV is personal — StudyPulse builds your own baseline over 7-14 days, so recommendations are tailored to you, not a population average."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV は個人差があります。StudyPulse は 7〜14 日であなた自身のベースラインを構築するため、サジェストは母集団の平均ではなく、あなた専用に調整されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV는 개인마다 다릅니다. StudyPulse는 7~14일 동안 나만의 기준선을 구축하므로, 일반적인 인구가 아닌 나에게 맞춘 추천을 제공합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV 是个性化的——StudyPulse 会在 7-14 天内建立你自己的基线，因此建议会针对你定制，而不是基于人群平均值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV 是個人化的——StudyPulse 會在 7-14 天內建立你自己的基準，因此建議會針對你個人調整，而不是基於族群平均值。"
          }
        }
      }
    },
